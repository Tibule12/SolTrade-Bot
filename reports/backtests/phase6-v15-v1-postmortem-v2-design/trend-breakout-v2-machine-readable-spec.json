      "0.50 <= atr14_c / atr14_mean_100_c <= 2.00"
    ],
    "sell": [
      "close_c < close_s",
      "close_c < frozen_donchian20_low_s",
      "close_c < ema200_c",
      "abs(close_c - ema200_c) <= 2.0 * atr14_c",
      "0.50 <= atr14_c / atr14_mean_100_c <= 2.00"
